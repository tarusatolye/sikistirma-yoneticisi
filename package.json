{
  "name": "sikistirma-yoneticisi",
  "private": true,
  "version": "0.0.1",
  "description": "tarus sıkıştırma yöneticisi — Windows ve macOS için açık kaynak kodlu arşiv yöneticisi",
  "author": "tarusatolye <yazilim@tarus.tr>",
  "copyright": "Copyright © 2026 tarusatolye",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarusatolye/sikistirma-yoneticisi.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/fetch-tools.cjs",
    "fetch-tools": "node scripts/fetch-tools.cjs",
    "icons": "electron scripts/make-icons.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.cjs",
    "start": "electron electron/main.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "node scripts/fetch-tools.cjs --platform win && npm run build && electron-builder --win nsis portable --x64",
    "dist:mac": "node scripts/fetch-tools.cjs --platform mac && npm run build && electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "tr.tarus.sikistirmayoneticisi",
    "productName": "Sikistirma Yoneticisi",
    "copyright": "Copyright © 2026 tarusatolye",
    "publish": [
      {
        "provider": "github",
        "owner": "tarusatolye",
        "repo": "sikistirma-yoneticisi"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      { "ext": ["rar", "r00", "r01"], "name": "RAR Archive", "role": "Viewer", "icon": "docs/icon" },
      { "ext": ["zip", "zipx"], "name": "ZIP Archive", "role": "Editor", "icon": "docs/icon" },
      { "ext": "7z", "name": "7-Zip Archive", "role": "Editor", "icon": "docs/icon" },
      { "ext": ["tar", "tgz", "gz", "bz2", "tbz2", "xz", "txz", "zst", "lz4", "lzma"], "name": "Compressed Archive", "role": "Viewer", "icon": "docs/icon" },
      { "ext": ["cab", "iso", "arj", "lzh", "cpio", "wim", "001"], "name": "Archive", "role": "Viewer", "icon": "docs/icon" }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "docs/icon.ico",
      "extraResources": [
        { "from": "bin/win", "to": "bin" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sıkıştırma Yöneticisi",
      "uninstallDisplayName": "Sıkıştırma Yöneticisi",
      "license": "build/license.txt",
      "artifactName": "Sikistirma-Yoneticisi-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Sikistirma-Yoneticisi-${version}-portable.${ext}"
    },
    "mac": {
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "docs/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "Sikistirma-Yoneticisi-${version}-mac.${ext}",
      "extraResources": [
        { "from": "bin/mac", "to": "bin" },
        { "from": "resources/mac", "to": "." }
      ],
      "extendInfo": {
        "CFBundleDisplayName": "Sikistirma Yoneticisi",
        "LSHasLocalizedDisplayName": true
      }
    },
    "dmg": {
      "title": "Sikistirma Yoneticisi",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
